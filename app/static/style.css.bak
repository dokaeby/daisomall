/* ============ tokens ============ */
:root {
  --accent: #e8402a;
  --accent-dark: #c22f1c;
  --accent-soft: #fff1ed;
  --ink: #17181a;
  --muted: #6b7280;
  --line: #e8eaed;
  --bg: #f6f7f8;
  --card: #fff;
  --ok: #15803d;
  --radius: 16px;
  --shadow-sm: 0 1px 2px rgba(16, 24, 40, 0.04);
  --shadow-md: 0 10px 28px rgba(16, 24, 40, 0.09);
  --pad: clamp(16px, 4vw, 24px);
  --tabbar: 62px;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  -webkit-text-size-adjust: 100%;
  scroll-padding-top: 80px;
}

body {
  margin: 0;
  font-family: -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", "Pretendard",
    "Noto Sans KR", "Malgun Gothic", sans-serif;
  color: var(--ink);
  background: var(--bg);
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
  overflow-wrap: break-word;
}

img,
svg {
  max-width: 100%;
}

a {
  color: inherit;
  text-decoration: none;
}

h1 {
  font-size: clamp(1.35rem, 2.6vw, 1.6rem);
  margin: 1.2rem 0 0.8rem;
  letter-spacing: -0.02em;
}
h2 {
  font-size: 1.1rem;
  margin: 0 0 0.8rem;
  letter-spacing: -0.01em;
}
h3 {
  font-size: 1rem;
  margin: 0.2rem 0 0.35rem;
}
p {
  margin: 0.4rem 0;
}
.muted {
  color: var(--muted);
  font-size: 0.9rem;
}
.right {
  text-align: right;
}
:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

.wrap {
  width: 100%;
  max-width: 1120px;
  margin-inline: auto;
  padding-inline: var(--pad);
}

/* ============ header ============ */
.topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  background: rgba(255, 255, 255, 0.94);
  -webkit-backdrop-filter: saturate(180%) blur(12px);
  backdrop-filter: saturate(180%) blur(12px);
  border-bottom: 1px solid var(--line);
}
.topbar-inner {
  display: flex;
  align-items: center;
  gap: 1rem;
  min-height: 60px;
  padding-block: 0.5rem;
}
.brand {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  font-weight: 800;
  font-size: 1.1rem;
  letter-spacing: -0.02em;
  white-space: nowrap;
}
.brand .logo {
  display: grid;
  place-items: center;
  width: 30px;
  height: 30px;
  border-radius: 9px;
  background: var(--accent);
  font-size: 0.95rem;
  line-height: 1;
}
.nav {
  display: flex;
  align-items: center;
  gap: 0.15rem;
  margin-left: auto;
  font-size: 0.9rem;
  flex-wrap: wrap;
}
.nav a,
.nav .linkish {
  padding: 0.45rem 0.7rem;
  border-radius: 9px;
  font-weight: 500;
  color: var(--ink);
}
.nav a:hover,
.nav .linkish:hover {
  background: var(--line);
}
.nav .pill {
  background: var(--accent);
  color: #fff;
}
.nav .pill:hover {
  background: var(--accent-dark);
}
.inline,
.inline-form {
  display: inline-flex;
  gap: 0.35rem;
  align-items: center;
  margin: 0;
  flex-wrap: wrap;
}
.linkish {
  background: none;
  border: 0;
  padding: 0;
  font: inherit;
  cursor: pointer;
}
.linkish.danger {
  color: var(--accent);
}
.count {
  display: inline-block;
  margin-left: 0.25rem;
  min-width: 1.15rem;
  padding: 0 0.3rem;
  border-radius: 999px;
  background: var(--accent);
  color: #fff;
  font-size: 0.72rem;
  font-weight: 700;
  line-height: 1.5;
  text-align: center;
}

/* mobile tab bar (hidden on desktop) */
.tabbar {
  display: none;
}

/* ============ flash + main ============ */
.flash {
  margin-top: 1rem;
  padding: 0.75rem 1rem;
  border-radius: 12px;
  background: var(--accent-soft);
  border: 1px solid #ffd8c6;
  white-space: pre-line;
  font-size: 0.92rem;
}
.main {
  padding-block: 0.5rem 3rem;
  min-height: 60vh;
}
.footer {
  padding-block: 2rem 3rem;
  color: var(--muted);
  font-size: 0.82rem;
}

/* ============ hero ============ */
.hero {
  position: relative;
  margin: 1.2rem 0 1rem;
  padding: clamp(1.5rem, 4vw, 2.6rem);
  border-radius: var(--radius);
  background: linear-gradient(135deg, #fff4ef 0%, #ffe9e1 55%, #ffdfd4 100%);
  overflow: hidden;
}
.hero::after {
  content: "";
  position: absolute;
  right: -50px;
  top: -60px;
  width: 200px;
  height: 200px;
  border-radius: 50%;
  background: rgba(232, 64, 42, 0.08);
  pointer-events: none;
}
.hero-badge {
  display: inline-block;
  margin-bottom: 0.7rem;
  padding: 0.2rem 0.65rem;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.8);
  border: 1px solid rgba(232, 64, 42, 0.18);
  color: var(--accent-dark);
  font-size: 0.75rem;
  font-weight: 700;
}
.hero h1 {
  position: relative;
  margin: 0 0 0.45rem;
  font-size: clamp(1.45rem, 3.6vw, 2.1rem);
  letter-spacing: -0.03em;
  line-height: 1.25;
}
.hero p {
  position: relative;
  margin: 0;
  color: #6b4a42;
  font-size: clamp(0.88rem, 1.6vw, 0.98rem);
}

/* ============ filters ============ */
.filters {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 11rem auto;
  gap: 0.5rem;
  margin: 0 0 0.75rem;
}
.filters input,
.filters select {
  width: 100%;
  min-width: 0;
}
.chips {
  display: flex;
  gap: 0.4rem;
  flex-wrap: wrap;
  margin: 0 0 1.2rem;
  min-width: 0;
}
.chip {
  flex: 0 0 auto;
  max-width: 100%;
  padding: 0.35rem 0.8rem;
  border-radius: 999px;
  background: var(--card);
  border: 1px solid var(--line);
  font-size: 0.85rem;
  font-weight: 500;
  color: var(--muted);
  white-space: nowrap;
}
.chip:hover {
  border-color: #cfd3d8;
  color: var(--ink);
}
.chip.active {
  background: var(--ink);
  color: #fff;
  border-color: var(--ink);
}

/* ============ product grid ============ */
.grid {
  display: grid;
  min-width: 0;
  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  gap: 0.75rem;
}
@media (min-width: 640px) {
  .grid {
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1rem;
  }
}
.card {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 14px;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
}
.card > a {
  display: flex;
  flex-direction: column;
  height: 100%;
}
.thumb {
  display: grid;
  place-items: center;
  font-size: clamp(2rem, 6vw, 2.7rem);
  aspect-ratio: 1;
  background: linear-gradient(180deg, #fbfbfc, #f3f4f6);
}
.card-body {
  display: flex;
  flex-direction: column;
  gap: 0.1rem;
  padding: 0.7rem 0.8rem 0.9rem;
}
.cat {
  font-size: 0.72rem;
  font-weight: 700;
  color: var(--muted);
}
.card h3 {
  margin: 0;
  font-size: 0.92rem;
  font-weight: 600;
  line-height: 1.4;
  min-height: 2.8em;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.price {
  margin: 0.15rem 0 0;
  font-weight: 800;
  font-size: 1.02rem;
  letter-spacing: -0.01em;
}
.price.big {
  font-size: clamp(1.5rem, 4vw, 2rem);
  font-weight: 800;
}
.tag {
  display: inline-block;
  padding: 0.08rem 0.45rem;
  border-radius: 6px;
  background: var(--line);
  font-size: 0.72rem;
  font-weight: 600;
}
.tag.soldout {
  background: #fee2e2;
  color: #b91c1c;
}
.card .tag {
  align-self: flex-start;
  margin-top: 0.35rem;
}
.empty {
  padding: 3rem 0;
  text-align: center;
  color: var(--muted);
}

.pagination {
  display: flex;
  gap: 0.35rem;
  justify-content: center;
  margin: 1.8rem 0 0.5rem;
}
.page {
  display: grid;
  place-items: center;
  min-width: 2.2rem;
  height: 2.2rem;
  padding: 0 0.5rem;
  border-radius: 10px;
  border: 1px solid var(--line);
  background: var(--card);
  font-size: 0.9rem;
  font-weight: 600;
}
.page:hover {
  border-color: #cfd3d8;
}
.page.active {
  background: var(--accent);
  color: #fff;
  border-color: var(--accent);
}

/* ============ product detail ============ */
.back {
  display: inline-block;
  margin-top: 1rem;
  color: var(--muted);
  font-size: 0.9rem;
}
.detail {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
  gap: clamp(1.2rem, 4vw, 2.4rem);
  margin-top: 1rem;
  align-items: start;
}
.detail-thumb {
  display: grid;
  place-items: center;
  font-size: clamp(4rem, 12vw, 6rem);
  aspect-ratio: 1;
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  position: sticky;
  top: 84px;
}
.detail-body h1 {
  margin: 0.25rem 0 0.6rem;
  font-size: clamp(1.3rem, 2.8vw, 1.7rem);
}
.desc {
  color: #374151;
  font-size: 0.95rem;
}
.stock {
  color: var(--muted);
  font-size: 0.9rem;
}
.buy {
  display: flex;
  gap: 0.6rem;
  align-items: center;
  margin-top: 1.2rem;
  flex-wrap: wrap;
}
.buy input[type="number"] {
  width: 5.5rem;
}

/* ============ forms ============ */
label {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
  font-size: 0.88rem;
  font-weight: 600;
}
input,
select {
  font: inherit;
  font-size: 1rem;
  min-height: 44px;
  padding: 0.55rem 0.7rem;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: #fff;
  color: var(--ink);
  font-weight: 400;
  max-width: 100%;
}
input[type="number"] {
  min-height: 40px;
}
input[type="search"] {
  -webkit-appearance: none;
  appearance: none;
}
input:focus,
select:focus {
  outline: 2px solid #ffcdbf;
  border-color: var(--accent);
}
.stack {
  display: flex;
  flex-direction: column;
  gap: 0.9rem;
}
.grid-form {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 0.8rem;
  align-items: end;
}
.grid-form .wide {
  grid-column: 1 / -1;
}
.error {
  padding: 0.7rem 0.9rem;
  border-radius: 12px;
  background: #fef2f2;
  border: 1px solid #fecaca;
  color: #b91c1c;
  white-space: pre-line;
  margin-bottom: 0.9rem;
  font-size: 0.92rem;
}
.auth-card,
.center-box {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: clamp(1.3rem, 4vw, 1.9rem);
  max-width: 420px;
  margin: clamp(1.5rem, 6vw, 3rem) auto;
  box-shadow: var(--shadow-sm);
}
.auth-card h1 {
  margin-top: 0;
}
.center-box {
  text-align: center;
}
.center-box .code {
  font-size: 3rem;
  font-weight: 800;
  color: var(--accent);
  margin: 0;
  letter-spacing: -0.04em;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.3rem;
  min-height: 40px;
  padding: 0.5rem 1.05rem;
  border-radius: 11px;
  border: 1px solid var(--line);
  background: var(--card);
  color: var(--ink);
  font: inherit;
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
  transition: background 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
}
.btn:hover {
  border-color: #cfd3d8;
  background: #fafafa;
}
.btn.primary {
  background: var(--accent);
  color: #fff;
  border-color: var(--accent);
  box-shadow: 0 2px 8px rgba(232, 64, 42, 0.22);
}
.btn.primary:hover {
  background: var(--accent-dark);
  border-color: var(--accent-dark);
}
.btn.danger {
  background: #b91c1c;
  color: #fff;
  border-color: #b91c1c;
}
.btn.danger:hover {
  background: #991b1b;
}
.btn.small {
  min-height: 32px;
  padding: 0.25rem 0.65rem;
  font-size: 0.8rem;
  border-radius: 8px;
}
.btn.block {
  width: 100%;
}
.actions {
  display: flex;
  gap: 0.6rem;
  justify-content: flex-end;
  margin-top: 1rem;
  flex-wrap: wrap;
}

/* ============ tables + panels ============ */
.table-wrap {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--card);
}
.table {
  width: 100%;
  min-width: 520px;
  border-collapse: collapse;
}
.table th,
.table td {
  padding: 0.75rem 0.85rem;
  border-bottom: 1px solid var(--line);
  text-align: left;
  font-size: 0.9rem;
  vertical-align: middle;
}
.table th {
  background: #fafafa;
  font-size: 0.78rem;
  color: var(--muted);
  font-weight: 700;
  white-space: nowrap;
}
.table tr:last-child td {
  border-bottom: 0;
}
.table tbody tr:hover {
  background: #fcfcfd;
}
.cell-product {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
.mini-thumb {
  font-size: 1.4rem;
}
.qty-form {
  display: flex;
  gap: 0.3rem;
  align-items: center;
}
.qty-form input {
  width: 4.2rem;
  min-height: 36px;
  padding: 0.3rem 0.5rem;
}

.panel {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: clamp(1rem, 3vw, 1.4rem);
  margin-bottom: 1.2rem;
  box-shadow: var(--shadow-sm);
}
.summary {
  display: flex;
  justify-content: flex-end;
  gap: 1rem;
  align-items: baseline;
  padding: 1rem 0.2rem;
  font-size: 1rem;
}
.summary strong {
  font-size: 1.35rem;
  color: var(--accent);
  letter-spacing: -0.02em;
}
.summary-list {
  list-style: none;
  margin: 0;
  padding: 0;
}
.summary-list li {
  display: flex;
  justify-content: space-between;
  gap: 0.8rem;
  padding: 0.45rem 0;
  border-bottom: 1px dashed var(--line);
  font-size: 0.9rem;
}
.summary-list li:last-child {
  border-bottom: 0;
}
.checkout {
  display: grid;
  grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
  gap: 1.2rem;
  align-items: start;
}

.pay {
  border: 0;
  padding: 0;
  display: flex;
  gap: 1.2rem;
  flex-wrap: wrap;
}
.pay legend {
  font-size: 0.88rem;
  font-weight: 600;
  margin-bottom: 0.4rem;
}
.radio {
  flex-direction: row;
  align-items: center;
  gap: 0.4rem;
  font-weight: 400;
  min-height: 32px;
}
.radio input {
  min-height: 0;
}

/* ============ order ============ */
.order-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 1rem;
  flex-wrap: wrap;
}
.order-head h1 {
  margin: 0.1rem 0 0.2rem;
  font-size: clamp(1.15rem, 2.4vw, 1.45rem);
  word-break: break-all;
}
.current-status {
  margin: 0;
  padding: 0.35rem 0.8rem;
  border-radius: 999px;
  background: var(--accent-soft);
  border: 1px solid #ffd8c6;
  font-weight: 700;
  font-size: 0.85rem;
  white-space: nowrap;
}
.timeline {
  display: flex;
  gap: 0;
  list-style: none;
  padding: 0;
  margin: 1.4rem 0;
}
.timeline li {
  flex: 1;
  position: relative;
  text-align: center;
  font-size: 0.78rem;
  color: var(--muted);
}
.timeline li::before {
  content: "";
  position: absolute;
  top: 7px;
  left: 0;
  width: 100%;
  height: 2px;
  background: var(--line);
}
.timeline li:first-child::before {
  left: 50%;
  width: 50%;
}
.timeline li:last-child::before {
  width: 50%;
}
.timeline .dot {
  position: relative;
  z-index: 1;
  display: block;
  width: 14px;
  height: 14px;
  margin: 0 auto 0.4rem;
  border-radius: 50%;
  background: #fff;
  border: 2px solid var(--line);
}
.timeline li.reached {
  color: var(--ink);
  font-weight: 700;
}
.timeline li.reached .dot {
  background: var(--accent);
  border-color: var(--accent);
}
.timeline li.reached::before {
  background: #f3b2a6;
}
.shipping {
  border-top: 1px solid var(--line);
  padding-top: 0.9rem;
}
.shipping h2 {
  font-size: 1rem;
  margin-bottom: 0.4rem;
}
.shipping p {
  margin: 0.2rem 0;
  font-size: 0.9rem;
}
.tracking {
  font-weight: 600;
}
.status {
  display: inline-block;
  padding: 0.1rem 0.5rem;
  border-radius: 6px;
  background: var(--line);
  font-size: 0.78rem;
  font-weight: 600;
  white-space: nowrap;
}
.status-paid {
  background: #dcfce7;
  color: var(--ok);
}
.status-shipped {
  background: #dbeafe;
  color: #1d4ed8;
}
.status-delivered {
  background: #ede9fe;
  color: #6d28d9;
}

.info {
  display: grid;
  grid-template-columns: 5rem 1fr;
  gap: 0.45rem 0.8rem;
  margin: 0 0 1rem;
  font-size: 0.92rem;
}
.info dt {
  color: var(--muted);
}
.info dd {
  margin: 0;
  word-break: break-all;
}
.danger-zone {
  border-color: #fecaca;
}

/* ============ hover (pointer devices only) ============ */
@media (hover: hover) and (pointer: fine) {
  .card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: #dfe2e6;
  }
}

/* ============ tablet ============ */
@media (max-width: 900px) {
  .topbar-inner {
    flex-wrap: wrap;
    row-gap: 0.25rem;
  }
  .nav {
    gap: 0.05rem;
    font-size: 0.86rem;
  }
  .checkout {
    grid-template-columns: 1fr;
  }
}

/* ============ mobile ============ */
@media (max-width: 720px) {
  .nav {
    display: none;
  }
  .topbar-inner {
    min-height: 56px;
    justify-content: space-between;
  }
  .detail {
    grid-template-columns: 1fr;
    gap: 1.1rem;
  }
  .detail-thumb {
    position: static;
    font-size: 5rem;
    aspect-ratio: 4 / 3;
    max-height: 320px;
  }
  .buy {
    display: grid;
    grid-template-columns: auto 5.5rem;
    align-items: center;
  }
  .buy input[type="number"] {
    width: 100%;
  }
  .buy .btn {
    grid-column: 1 / -1;
    min-height: 48px;
  }
  .actions {
    justify-content: stretch;
  }
  .actions .btn {
    flex: 1;
    min-height: 46px;
  }
  .auth-card,
  .center-box {
    margin-block: 1.2rem;
    max-width: none;
  }

  body {
    padding-bottom: calc(var(--tabbar) + env(safe-area-inset-bottom, 0px));
  }
  .tabbar {
    display: flex;
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 30;
    background: rgba(255, 255, 255, 0.97);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-top: 1px solid var(--line);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  .tabbar a {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    padding: 0.4rem 0 0.45rem;
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--muted);
  }
  .tabbar a.active {
    color: var(--accent);
  }
  .tabbar .tab-ico {
    font-size: 1.15rem;
    line-height: 1.1;
  }
  .tabbar .count {
    position: absolute;
    top: 1px;
    left: calc(50% + 5px);
    margin: 0;
  }
  .footer {
    padding-bottom: 1.5rem;
  }
}

@media (max-width: 640px) {
  .filters {
    grid-template-columns: minmax(0, 1fr) auto;
  }
  .filters input[type="search"] {
    grid-column: 1 / -1;
  }
  .chips {
    flex-wrap: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 2px;
  }
  .chips::-webkit-scrollbar {
    display: none;
  }
  .hero {
    margin-top: 0.9rem;
  }
  .grid-form .wide {
    grid-column: auto;
  }
  .panel {
    margin-inline: 0;
  }
  .info {
    grid-template-columns: 4rem 1fr;
  }

  /* cart rows become cards */
  .table.cart-table {
    min-width: 0;
  }
  .table.cart-table thead {
    display: none;
  }
  .table.cart-table tbody tr {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 0.85rem;
    border-bottom: 1px solid var(--line);
  }
  .table.cart-table tbody tr:last-child {
    border-bottom: 0;
  }
  .table.cart-table td {
    padding: 0;
    border: 0;
  }
  .table.cart-table td:nth-child(1) {
    grid-column: 1 / -1;
  }
  .table.cart-table td:nth-child(3) {
    text-align: right;
    font-weight: 700;
  }
  .table.cart-table td:nth-child(4) {
    text-align: right;
  }
}

@media (max-width: 420px) {
  .timeline li {
    font-size: 0.68rem;
  }
  .timeline .dot {
    width: 12px;
    height: 12px;
  }
  .timeline li::before {
    top: 6px;
  }
  .card-body {
    padding: 0.6rem 0.65rem 0.75rem;
  }
  .card h3 {
    font-size: 0.85rem;
  }
}

/* ============ language switcher ============ */
.lang-switch {
  font-size: 12px;
  font-weight: 600;
  color: var(--accent);
  text-decoration: none;
  letter-spacing: 0.02em;
  padding: 4px 8px;
  border: 1px solid var(--accent);
  border-radius: 6px;
  margin-left: 8px;
  transition: background 0.15s;
}
.lang-switch:hover {
  background: var(--accent-soft);
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    transition: none !important;
    animation: none !important;
  }
}
